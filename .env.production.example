# Settings for the live server. Copy this file to .env on the server and
# fill in the values marked CHANGE. See docs/DEPLOY-CPANEL.md.
# After changing .env on the server, run "php artisan app:install" again.

APP_NAME="School Management System"
APP_ENV=production
APP_DEBUG=false
# CHANGE: generate in Codespaces with: php artisan key:generate --show
APP_KEY=
# CHANGE: the system's address, with https
APP_URL=https://sms.sharebility.net
APP_TIMEZONE=Africa/Kampala

# Leave empty until the wildcard subdomain (*.sms.sharebility.net) and its SSL
# certificate are ready. Then set it to the main domain, e.g. sms.sharebility.net,
# and each school opens at its own address, e.g. stmarys.sms.sharebility.net
SCHOOL_TENANT_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# CHANGE: from cPanel → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_sms
DB_USERNAME=cpaneluser_sms
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
# CHANGE: email for logins and "forgot password". Create a mailbox in cPanel
# (Email Accounts), e.g. no-reply@sharebility.net, then fill these in from
# its "Connect Devices" page (outgoing server, SSL port 465).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.sharebility.net
MAIL_PORT=465
MAIL_USERNAME=no-reply@sharebility.net
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@sharebility.net
MAIL_FROM_NAME="${APP_NAME}"

# CHANGE: a private address for the Sharebility admin panel instead of /admin,
# e.g. ADMIN_PATH=sharebility-hq-7k2 (letters, numbers and dashes). Only you
# should know it. School addresses (subdomains) can never open it.
ADMIN_PATH=admin

# Only if links to storage aren't allowed on the server (photos don't show):
# PUBLIC_DISK_ROOT=/home/cpaneluser/sms/public/storage

# SMS: "log" only records messages. Use "africastalking" to really send them,
# and switch SMS on for each school in the admin panel.
SMS_DRIVER=log
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
